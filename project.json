{
  "title": "3D Printer Simulator",
  "description": "Interactive CoreXY 3D printing live wallpaper with .3MF multicolor & .STL support, model scale/rotation, Night Mode, reverse loop playback, and persistent camera framing.",
  "type": "web",
  "file": "index.html",
  "general": {
    "supportsaudioprocessing": false,
    "properties": {
      "showwebmenu": {
        "order": 1,
        "text": "Show Settings Gear Button",
        "type": "bool",
        "value": true
      },
      "modelfile": {
        "order": 2,
        "text": "Custom 3D Model (.stl / .3mf)",
        "type": "file",
        "fileType": "any"
      },
      "nightmode": {
        "order": 3,
        "text": "Night Mode",
        "type": "bool",
        "value": false
      },
      "reverseloop": {
        "order": 4,
        "text": "Reverse Loop",
        "type": "bool",
        "value": true
      },
      "lockcamera": {
        "order": 5,
        "text": "Lock Camera Position",
        "type": "bool",
        "value": false
      },
      "filamentcolor": {
        "order": 6,
        "text": "Filament Color",
        "type": "color",
        "value": "0 0.66 1"
      },
      "use3mfcolors": {
        "order": 7,
        "text": "Use .3MF Embedded Colors",
        "type": "bool",
        "value": true
      },
      "enableinfill": {
        "order": 8,
        "text": "Print Infill",
        "type": "bool",
        "value": true
      },
      "infilldensity": {
        "order": 9,
        "text": "Infill Density (%)",
        "type": "slider",
        "min": 10,
        "max": 60,
        "value": 20
      },
      "printercolor": {
        "order": 10,
        "text": "Frame Color",
        "type": "color",
        "value": "0.14 0.15 0.19"
      },
      "chassisopacity": {
        "order": 11,
        "text": "Frame Opacity",
        "type": "slider",
        "min": 0.0,
        "max": 1.0,
        "value": 0.35
      },
      "bgcolor": {
        "order": 12,
        "text": "Background Color",
        "type": "color",
        "value": "0.05 0.06 0.08"
      },
      "printspeed": {
        "order": 13,
        "text": "Print Speed (0 = Pause)",
        "type": "slider",
        "min": 0.0,
        "max": 5.0,
        "value": 1.0
      },
      "autorotate": {
        "order": 14,
        "text": "Auto Rotate Camera",
        "type": "bool",
        "value": true
      },
      "rotatespeed": {
        "order": 15,
        "text": "Camera Rotate Speed",
        "type": "slider",
        "min": 0.1,
        "max": 3.0,
        "value": 0.5
      }
    }
  }
}
